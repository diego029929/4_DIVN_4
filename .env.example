# Copie ce fichier en .env.local et remplis les valeurs. Ne commite jamais .env.local.

# URL publique du site (sans / final), ex. https://divn.mon-compte.workers.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Secret du webhook /api/webhooks/stripe (événement checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Email qui reçoit chaque nouvelle commande
ORDER_NOTIFICATION_EMAIL=
# Envoi des emails (Brevo)
BREVO_API_KEY=
# Adresse expéditrice validée dans Brevo
BREVO_SENDER_EMAIL=

# Comptes clients (NextAuth + Postgres) : optionnels pour vendre
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Email du compte administrateur
ADMIN_EMAIL=

# Suivi des erreurs : optionnels
BETTERSTACK_SOURCE_TOKEN=
